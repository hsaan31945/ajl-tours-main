# Local frontend environment
NODE_ENV=development

# API
# Leave empty to use the Vite proxy/same-origin API paths, or set http://localhost:3000.
VITE_API_URL=http://localhost:3000

# Admin
VITE_ADMIN_PASSCODE=admin123

# Stripe
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_publishable_key

# Google Maps
VITE_GOOGLE_MAPS_API_KEY=replace_with_google_maps_browser_key

# Build
GENERATE_SOURCEMAP=false
