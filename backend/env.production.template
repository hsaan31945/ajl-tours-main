# Production Environment Configuration
# Copy this file to .env and update values for your server

# Server Configuration
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Database Configuration (MongoDB Atlas)
# Format: mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/DATABASE_NAME?appName=APP_NAME
# 
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/DATABASE_NAME?appName=APP_NAME

# Admin Configuration
ADMIN_PASSCODE=replace_with_a_strong_admin_passcode

# Stripe Configuration
STRIPE_SECRET_KEY=sk_live_replace_with_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_webhook_secret

# Frontend Configuration
FRONTEND_URL=https://yourdomain.com

# Email Configuration (Resend)
RESEND_API_KEY=re_replace_with_resend_api_key
RESEND_FROM_EMAIL=AJL Tours <noreply@yourdomain.com>
SUPPORT_NOTIFICATION_EMAIL=hey@ajltour.com

# SSL Configuration (uncomment when you have certificates)
# SSL_ENABLED=true
# SSL_KEY_PATH=/path/to/your/private.key
# SSL_CERT_PATH=/path/to/your/certificate.crt

# CORS Configuration
CORS_ORIGIN=https://yourdomain.com

# Security (optional)
SESSION_SECRET=your_session_secret_here
COOKIE_SECRET=your_cookie_secret_here

# Logging
LOG_LEVEL=info
LOG_FILE=/var/log/tripgo/app.log

# Performance
MAX_FILE_SIZE=10mb
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX=100
