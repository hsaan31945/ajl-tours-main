# Frontend Production Environment Configuration
# Copy this file to .env.production and update values for your server

# Stripe Configuration
VITE_STRIPE_PUBLISHABLE_KEY=replace_with_stripe_publishable_key

# API Configuration
VITE_API_URL=https://yourdomain.com

# Admin Configuration
VITE_ADMIN_PASSCODE=replace_with_a_strong_admin_passcode
VITE_GOOGLE_MAPS_API_KEY=replace_with_google_maps_browser_key

# Environment
NODE_ENV=production

# Build Configuration
GENERATE_SOURCEMAP=false
