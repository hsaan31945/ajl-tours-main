{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://ajl-tours-backend-phi.vercel.app/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|avif|svg|gif|mp4|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "env": {
    "REACT_APP_STRIPE_PUBLISHABLE_KEY": "pk_live_51SI58bETHCR5wUAm8WAPumpfpbeN0jsgiLHPR3xas7x4M8Iaw113HcKNmr59b3nUvem6M3GSx5w3BaihXun7OnLO001bVxhJV6",
    "VITE_STRIPE_PUBLISHABLE_KEY": "pk_live_51SI58bETHCR5wUAm8WAPumpfpbeN0jsgiLHPR3xas7x4M8Iaw113HcKNmr59b3nUvem6M3GSx5w3BaihXun7OnLO001bVxhJV6",
    "VITE_API_URL": "https://ajl-tours-backend-phi.vercel.app",
